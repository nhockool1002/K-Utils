{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K-Utils",
  "version": "0.1.0",
  "identifier": "com.kutils.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "K-Utils",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": {
      "binaries/ffmpeg-libs/*": "ffmpeg-libs/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
